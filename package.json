{
  "name": "garment-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run audit:document-loads && next build",
    "start": "next start",
    "lint": "next lint",
    "sync:clickup": "node --experimental-strip-types scripts/run-clickup-import.mjs",
    "db:migrate-json": "node scripts/migrate-json-to-supabase.mjs",
    "loro-piana:sync-swatches": "node scripts/sync-loro-piana-swatches-to-supabase.mjs",
    "db:sync-from-supabase": "echo 'WARNING: supplier_contacts + clients sync preserve linked/required data — stale Supabase cannot drop solbiati/canclini/wool-stock or clients still on sales orders.' && node scripts/sync-documents-from-supabase.mjs",
    "db:seed-canclini": "node --experimental-strip-types --import ./scripts/tsconfig-paths-loader.mjs scripts/seed-canclini-inventory.mjs",
    "db:archive-fabric-receipts": "node scripts/archive-historical-fabric-receipts.mjs",
    "drapers:sync-stock": "node --experimental-strip-types --import ./scripts/tsconfig-paths-loader.mjs scripts/sync-drapers-stock.mjs --open-orders",
    "drapers:sync-catalog": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs scripts/sync-drapers-catalog.mjs --open-orders",
    "drapers:sync-cache": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs scripts/sync-drapers-cache.mjs",
    "drapers:sync-cache:open-orders": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs scripts/sync-drapers-cache.mjs --open-orders",
    "drapers:sync-swatches": "node scripts/sync-drapers-swatches-to-supabase.mjs",
    "caccioppoli:download-swatches": "node scripts/download-caccioppoli-fabric-images.mjs",
    "caccioppoli:sync-swatches": "node scripts/sync-caccioppoli-swatches-to-supabase.mjs",
    "drapers:sync-availability": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs scripts/sync-drapers-stock.mjs --catalog",
    "test:drapers-catalog": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/integrations/drapers/catalog-fields.test.ts",
    "verify:fabric-reset": "node scripts/verify-fabric-receiving-reset.mjs",
    "verify:label-counts": "node scripts/verify-factory-label-counts.mjs",
    "audit:document-loads": "node scripts/audit-document-loads.mjs",
    "test:consolidate-lines": "node --experimental-strip-types scripts/test-consolidate-lines.mjs",
    "test:invoice-vat": "node --experimental-strip-types scripts/test-invoice-vat.mjs",
    "test:price-access": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/auth/fabric-price-access.test.ts",
    "test:tud-parser": "node --experimental-strip-types --test src/lib/pattern-library/tud-parser.test.ts",
    "test:dxf-parser": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/pattern-library/dxf-parser.test.ts",
    "loro-piana:extract-swatch-colors": "node scripts/extract-loro-piana-swatch-colors.mjs",
    "test:swatch-colors": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/fabric-sourcing/swatch-color-name.test.ts",
    "test:sewing-session": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/production/sewing-session.test.ts",
    "test:sewing-scan-explain": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/production/sewing-scan-code-explain.test.ts",
    "proof:dxf-outlines": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs scripts/proof-dxf-outlines.mjs",
    "test:tud-size-fill": "node --experimental-strip-types --test src/lib/pattern-library/tud-size-fill.test.ts",
    "test:load-from-base": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/pattern-library/load-from-base.test.ts",
    "test:base-pattern-picker": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/pattern-library/base-pattern-picker.test.ts",
    "test:client-fit-columns": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/pattern-library/client-fit-columns.test.ts",
    "test:a4-print-styles": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/sales-orders/receiving-print-styles.test.ts",
    "test:recent-fabric-highlight": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/fabric-sourcing/recent-fabric-highlight.test.ts",
    "test:permissions": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/auth/permissions.production.test.ts",
    "test:quality-inspections": "node --experimental-strip-types --experimental-loader ./scripts/tsconfig-paths-loader.mjs --test src/lib/quality/inspections.test.ts",
    "proof:a4-production-print": "node scripts/proof-a4-production-print.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "verify:deploy": "npm run audit:document-loads && npm run smoke:production",
    "db:types": "supabase gen types typescript --local > src/lib/types/database.generated.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "heic-convert": "^2.1.0",
    "imapflow": "^1.3.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.511.0",
    "mailparser": "^3.9.8",
    "next": "^15.3.3",
    "nodemailer": "^8.0.9",
    "pdf-parse": "^2.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.2",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
